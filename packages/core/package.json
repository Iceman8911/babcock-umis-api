{
	"dependencies": {
		"better-ts-enum": "^0.5.0",
		"dotenv": "^17.4.1",
		"node-html-parser": "^7.0.2",
		"valibot": "^1.2.0"
	},
	"description": "Reverse-engineered api for babcock's umis portal",
	"devDependencies": {
		"@biomejs/biome": "2.4.10",
		"@types/bun": "^1.3.11",
		"bumpp": "^11.0.1",
		"bunup": "^0.16.26",
		"typescript": "^6.0.2"
	},
	"exports": {
		".": {
			"import": {
				"default": "./dist/index.js",
				"types": "./dist/index.d.ts"
			},
			"require": {
				"default": "./dist/index.cjs",
				"types": "./dist/index.d.cts"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"dist/node",
		"dist/html-rewriter",
		"dist/min"
	],
	"license": "MIT",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"name": "@babcock-umis-api/core",
	"peerDependencies": {
		"typescript": ">=4.5.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"scripts": {
		"build": "bunup",
		"check": "biome check --write",
		"check-types": "tsc --noEmit",
		"dev": "bunup --watch",
		"release": "bumpp --commit --push --tag",
		"test": "bun test --concurrent --timeout=20000 --coverage"
	},
	"sideEffects": false,
	"type": "module",
	"types": "./dist/index.d.ts",
	"version": "0.1.1"
}
