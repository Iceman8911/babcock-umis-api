{
	"dependencies": {
		"better-ts-enum": "^0.5.0",
		"dotenv": "^17.4.1",
		"node-html-parser": "^7.0.2",
		"valibot": "^1.2.0"
	},
	"description": "Reverse-engineered api for babcock's umis portal",
	"devDependencies": {
		"@biomejs/biome": "2.4.10",
		"@types/bun": "^1.3.11",
		"bunup": "^0.16.26",
		"typescript": "^6.0.2"
	},
	"exports": {
		"./html-rewriter": {
			"import": {
				"default": "./dist/html-rewriter.js",
				"types": "./dist/html-rewriter.d.ts"
			},
			"require": {
				"default": "./dist/html-rewriter.cjs",
				"types": "./dist/html-rewriter.d.cts"
			}
		},
		"./node": {
			"import": {
				"default": "./dist/node.js",
				"types": "./dist/node.d.ts"
			},
			"require": {
				"default": "./dist/node.cjs",
				"types": "./dist/node.d.cts"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"dist/node",
		"dist/html-rewriter",
		"dist/min"
	],
	"license": "MIT",
	"name": "@packages/core",
	"peerDependencies": {
		"typescript": ">=4.5.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"scripts": {
		"build": "bunup",
		"check": "biome check --write",
		"check-types": "tsc --noEmit",
		"dev": "bunup --watch",
		"test": "bun test --concurrent --timeout=10000"
	},
	"type": "module",
	"version": "0.1.0"
}
