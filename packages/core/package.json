{
	"dependencies": {
		"node-html-parser": "^7.0.2"
	},
	"description": "Reverse-engineered api for babcock's umis portal",
	"devDependencies": {
		"@biomejs/biome": "2.4.0",
		"@types/bun": "^1.3.9",
		"bunup": "^0.16.26",
		"typescript": "^5.9.3"
	},
	"exports": {
		"./browser": {
			"import": "./dist/browser.js",
			"types": "./dist/browser.d.ts"
		},
		"./html-rewriter": {
			"import": "./dist/html-rewriter.js",
			"types": "./dist/html-rewriter.d.ts"
		},
		"./node": {
			"import": "./dist/node.js",
			"require": "./dist/node.cjs",
			"types": "./dist/node.d.ts"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"license": "MIT",
	"name": "@packages/core",
	"peerDependencies": {
		"typescript": ">=4.5.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"scripts": {
		"build": "bunup",
		"check": "biome check --write",
		"check-types": "tsc --noEmit",
		"dev": "bunup --watch",
		"test": "bun test"
	},
	"type": "module",
	"version": "0.1.0"
}
